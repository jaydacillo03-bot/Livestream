<Window x:Class="LivestreamStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mosaic Studio"
        Width="1480"
        Height="940"
        MinWidth="1080"
        MinHeight="720"
        Background="#0B0D12"
        Foreground="#F5F5F8"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#11141D" />
        <SolidColorBrush x:Key="CardBrush" Color="#171B26" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9499A9" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8768FF" />
        <SolidColorBrush x:Key="LineBrush" Color="#252A37" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F5F8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D6D8E1" />
            <Setter Property="Background" Value="#1A1E29" />
            <Setter Property="BorderBrush" Value="#2A2F3D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#232837" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#7355EE" />
            <Setter Property="BorderBrush" Value="#8B72FA" />
        </Style>

        <Style x:Key="WorkspaceButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <DataTemplate x:Key="FeedTemplate">
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="#282D3B"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="13"
                    Margin="0,0,10,0"
                    Width="190">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Border Width="31"
                                Height="31"
                                CornerRadius="8"
                                HorizontalAlignment="Left"
                                Background="{Binding Accent}">
                            <TextBlock Text="{Binding ArtworkLabel}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding TypeLabel}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="FeedItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="10"
                                Margin="0,0,10,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#987FFF" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1D1930" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="66" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="10"
                            Background="#7355EE">
                        <TextBlock Text="M"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MOSAIC" FontSize="13" FontWeight="Bold" />
                        <TextBlock Text="STUDIO" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Background="#0C0E15">
                    <Button x:Name="StudioModeButton"
                            Content="STUDIO"
                            Style="{StaticResource WorkspaceButton}"
                            Click="OnStudioModeClick" />
                    <Button x:Name="ViewerModeButton"
                            Content="WATCH"
                            Style="{StaticResource WorkspaceButton}"
                            Click="OnViewerModeClick" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border Background="#201B2E"
                            CornerRadius="6"
                            Padding="9,5"
                            Margin="0,0,12,0">
                        <TextBlock Text="LOCAL PREVIEW"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#C2B4FF"
                                   />
                    </Border>
                    <Button Content="Save studio"
                            Style="{StaticResource QuietButton}"
                            Click="OnSaveStudioClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="0,0,12,0">
                <StackPanel Margin="9,16">
                    <Border Background="#29203F"
                            CornerRadius="9"
                            Height="42"
                            Margin="0,0,0,8">
                        <TextBlock Text="◈"
                                   FontSize="19"
                                   Foreground="#BDAEFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="ON AIR"
                               FontSize="8"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer x:Name="StudioWorkspace"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="6,4,18,18">
                        <Grid Margin="0,0,0,17">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="LIVE STUDIO"
                                           Foreground="#A996FF"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           />
                                <TextBlock Text="Your scenes, your show."
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="Arrange video feeds and choose what your audience sees."
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Margin="0,12,0,0">
                                <ComboBox x:Name="CameraSourceList"
                                          ItemsSource="{Binding Cameras}"
                                          DisplayMemberPath="Name"
                                          MinWidth="165"
                                          MaxWidth="230"
                                          Height="34"
                                          VerticalContentAlignment="Center"
                                          Background="#171B26"
                                          Foreground="#F5F5F8"
                                          BorderBrush="#2A2F3D"
                                          ToolTip="Choose a connected camera to add as a feed"
                                          SelectionChanged="OnCameraSourceSelectionChanged" />
                                <Button Content="Refresh"
                                        x:Name="RefreshCamerasButton"
                                        Style="{StaticResource QuietButton}"
                                        Padding="11,7"
                                        Margin="6,0,0,0"
                                        ToolTip="Find cameras currently connected to this PC"
                                        Click="OnRefreshCamerasClick" />
                                <Button Content="Add camera"
                                        x:Name="AddCameraButton"
                                        Style="{StaticResource QuietButton}"
                                        Padding="11,7"
                                        Margin="6,0,0,0"
                                        ToolTip="Add the selected camera as a live preview feed"
                                        Click="OnAddCameraClick" />
                                <Button Content="Import video"
                                        x:Name="ImportVideoButton"
                                        Style="{StaticResource QuietButton}"
                                        Padding="11,7"
                                        Margin="6,0,0,0"
                                        Click="OnImportVideoClick" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="BROADCAST AUDIO"
                                           VerticalAlignment="Center"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}" />
                                <ComboBox x:Name="AudioSourceList"
                                          ItemsSource="{Binding AudioDevices}"
                                          MinWidth="165"
                                          MaxWidth="230"
                                          Height="32"
                                          Margin="9,0,0,0"
                                          VerticalContentAlignment="Center"
                                          Background="#171B26"
                                          Foreground="#F5F5F8"
                                          BorderBrush="#2A2F3D"
                                          ToolTip="Choose a microphone to include in a live camera broadcast" />
                                <CheckBox x:Name="IncludeMicrophoneCheckBox"
                                          Content="Include microphone audio"
                                          Foreground="#D6D8E1"
                                          VerticalAlignment="Center"
                                          Margin="10,0,0,0"
                                          ToolTip="Microphone audio is disabled unless you opt in."
                                          IsEnabled="False" />
                            </StackPanel>
                        </Grid>

                        <Border Background="#171421"
                                BorderBrush="#352A55"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12,10"
                                Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="i"
                                           FontWeight="Bold"
                                           Foreground="#C4B5FD"
                                           Margin="0,0,9,0" />
                                <TextBlock Text="Preview only. No video is being sent to a streaming platform."
                                           Foreground="#D8D0EB"
                                           FontSize="10" />
                            </StackPanel>
                        </Border>

                        <Border Background="#10131B"
                                BorderBrush="#292D3A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <Grid Height="350" ClipToBounds="True">
                                <Border CornerRadius="8" Background="#10121B">
                                    <Grid>
                                        <Ellipse Width="430"
                                                 Height="300"
                                                 Fill="#242044"
                                                 Opacity="0.42"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                                        <Ellipse Width="290"
                                                 Height="220"
                                                 Fill="#272351"
                                                 Opacity="0.30"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom"
                                                 Margin="0,0,70,18" />
                                    </Grid>
                                </Border>

                                <MediaElement x:Name="StudioMedia"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Manual"
                                              Stretch="Uniform"
                                              MediaOpened="OnMediaOpened"
                                              MediaEnded="OnMediaEnded"
                                              MediaFailed="OnMediaFailed"
                                              Visibility="Collapsed" />

                                <Image x:Name="StudioCameraImage"
                                       Stretch="Uniform"
                                       Visibility="Collapsed" />

                                <StackPanel x:Name="StudioEmptyState"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MaxWidth="370">
                                    <Border Width="52"
                                            Height="52"
                                            Background="#28223F"
                                            CornerRadius="16"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,16">
                                        <TextBlock Text="▶"
                                                   FontSize="17"
                                                   Foreground="#C5B9FF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="StudioEmptyTitle"
                                               Text="Your preview starts here"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="StudioEmptyMessage"
                                               Text="Add a camera feed using the controls above, or import a local video to preview it."
                                               FontSize="11"
                                               LineHeight="18"
                                               TextAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,8,0,0" />
                                    <Button Content="Choose a video"
                                            Style="{StaticResource QuietButton}"
                                            HorizontalAlignment="Center"
                                            Margin="0,15,0,0"
                                            Click="OnImportVideoClick" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="13">
                                    <Border Background="#202330"
                                            CornerRadius="5"
                                            Padding="8,5"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="STUDIO PREVIEW"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   />
                                    </Border>
                                    <Border Background="#29203F"
                                            CornerRadius="5"
                                            Padding="8,5">
                                        <TextBlock Text="NOT BROADCASTING"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   Foreground="#C9BBFF"
                                                   />
                                    </Border>
                                </StackPanel>

                                <Border VerticalAlignment="Bottom"
                                        Background="#E9101118"
                                        Padding="14,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="StudioSceneTitle"
                                                       Text="Main camera"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="StudioSceneStatus"
                                                       Text="Camera input · not connected"
                                                       Foreground="#B5B8C6"
                                                       FontSize="9"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                x:Name="StudioPlaybackButton"
                                                Content="▶"
                                                Style="{StaticResource QuietButton}"
                                                Padding="11,6"
                                                Margin="8,0,0,0"
                                                        ToolTip="Play, pause, or resume the selected camera or video preview"
                                                Click="OnPlaybackClick" />
                                        <Slider Grid.Column="2"
                                                x:Name="VolumeSlider"
                                                Width="94"
                                                Minimum="0"
                                                Maximum="1"
                                                Value="0.8"
                                                Margin="12,0,4,0"
                                                VerticalAlignment="Center"
                                                ToolTip="Preview volume"
                                                ValueChanged="OnVolumeChanged" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,18,0,9">
                            <StackPanel>
                                <TextBlock Text="Your feeds" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Choose a scene or add a local video for the preview."
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="FeedCountText"
                                       Text="0 FEEDS"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ListBox x:Name="StudioFeedList"
                                 ItemsSource="{Binding Feeds}"
                                 ItemTemplate="{StaticResource FeedTemplate}"
                                 ItemContainerStyle="{StaticResource FeedItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnStudioFeedSelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <TextBlock x:Name="StatusText"
                                   Text="Studio preview is ready."
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ViewerWorkspace"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <StackPanel Margin="6,4,18,18">
                        <Grid Margin="0,0,0,17">
                            <StackPanel>
                                <TextBlock Text="AUDIENCE VIEW"
                                           Foreground="#A996FF"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           />
                                <TextBlock Text="What do you want to watch?"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="Select a feed to follow. The selection applies to this local preview."
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Background="#10131B"
                                BorderBrush="#292D3A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <Grid Height="420" ClipToBounds="True">
                                <Border CornerRadius="8" Background="#10121B">
                                    <Grid>
                                        <Ellipse Width="470"
                                                 Height="320"
                                                 Fill="#242044"
                                                 Opacity="0.42"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <MediaElement x:Name="ViewerMedia"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Manual"
                                              Stretch="Uniform"
                                              MediaOpened="OnMediaOpened"
                                              MediaEnded="OnMediaEnded"
                                              MediaFailed="OnMediaFailed"
                                              Visibility="Collapsed" />
                                <Image x:Name="ViewerCameraImage"
                                       Stretch="Uniform"
                                       Visibility="Collapsed" />
                                <StackPanel x:Name="ViewerEmptyState"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MaxWidth="370">
                                    <Border Width="50"
                                            Height="50"
                                            Background="#28223F"
                                            CornerRadius="16"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,15">
                                        <TextBlock Text="◈"
                                                   FontSize="20"
                                                   Foreground="#C5B9FF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="ViewerEmptyTitle"
                                               Text="Pick a feed to get started"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="ViewerEmptyMessage"
                                               Text="Your selected feed will appear here when a video source is available."
                                               FontSize="11"
                                               LineHeight="18"
                                               TextAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                                <Border HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="#202330"
                                        CornerRadius="5"
                                        Padding="8,5"
                                        Margin="13">
                                    <TextBlock Text="AUDIENCE PREVIEW"
                                               FontSize="8"
                                               FontWeight="Bold"
                                               />
                                </Border>
                                <Border VerticalAlignment="Bottom"
                                        Background="#E9101118"
                                        Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="NOW WATCHING"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   Foreground="#BBAAFF"
                                                   />
                                        <TextBlock x:Name="ViewerSceneTitle"
                                                   Text="Main camera"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="0,3,0,0" />
                                        <TextBlock x:Name="ViewerSceneStatus"
                                                   Text="Camera input · not connected"
                                                   FontSize="10"
                                                   Foreground="#B5B8C6"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,20,0,10">
                            <StackPanel>
                                <TextBlock Text="Available feeds" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Choose which view you want to follow."
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <ListBox x:Name="ViewerFeedList"
                                 ItemsSource="{Binding Feeds}"
                                 ItemTemplate="{StaticResource FeedTemplate}"
                                 ItemContainerStyle="{StaticResource FeedItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnViewerFeedSelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <TextBlock x:Name="ViewerStatusText"
                                   Text="Audience preview is ready."
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border x:Name="StudioSidebar"
                    Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="12,0,0,0"
                    Padding="17">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="STREAM DESTINATIONS"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#BBAAFF"
                                   />
                        <TextBlock Text="Where you’ll go live"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="Set up each streaming account, then choose where to send the broadcast."
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,5,0,17" />

                        <ItemsControl x:Name="DestinationList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#171B26"
                                            BorderBrush="#292E3B"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="10,11"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="35" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="29"
                                                    Height="29"
                                                    CornerRadius="8"
                                                    Background="{Binding Accent}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Initial}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="3,0,3,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="9"
                                                               Foreground="{Binding StatusBrush}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Content="SETUP"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource QuietButton}"
                                                    Padding="8,6"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Set the RTMP server and securely store a stream key"
                                                    Click="OnConfigureDestinationClick" />
                                            <CheckBox Grid.Column="3"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsConfigured}"
                                                      Checked="OnDestinationSelectionChanged"
                                                      Unchecked="OnDestinationSelectionChanged"
                                                      ToolTip="Send the broadcast to this configured destination" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="+  Add RTMP destination"
                                Style="{StaticResource QuietButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,3,0,0"
                                Click="OnAddDestinationClick" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <Border Background="#191522"
                                BorderBrush="#342B48"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="11">
                            <StackPanel>
                                <TextBlock Text="Stream setup"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Stream keys are encrypted for this Windows account. No stream will start until you set up and select at least one destination."
                                           FontSize="9"
                                           LineHeight="15"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Button Content="Start broadcast"
                                x:Name="StartBroadcastButton"
                                Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,11,0,0"
                                ToolTip="Start publishing to connected streaming platforms"
                                Click="OnStartBroadcastClick" />
                        <TextBlock x:Name="DestinationCountText"
                                   Text="0 DESTINATIONS SELECTED"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,9,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
